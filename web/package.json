{
  "name": "blinkguard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BlinkGuard web app: eye-closure alarm and PDF reader running entirely in the browser",
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
